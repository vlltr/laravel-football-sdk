{
    "name": "football-api/laravel-sdk",
    "description": "Unofficial Laravel SDK for the 5DollarFootballAPI",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.21",
        "orchestra/testbench": "^10.0 || ^11.0",
        "phpunit/phpunit": "^11.5 || ^12.0"
    },
    "autoload": {
        "psr-4": {
            "FootballApi\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "FootballApi\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "FootballApi\\FootballServiceProvider"
            ],
            "aliases": {
                "Football": "FootballApi\\Facades\\Football"
            }
        }
    },
    "minimum-stability": "stable",
    "config": {
        "sort-packages": true
    }
}
